# Names only. Real values live in your shell, a local .env that git ignores, or Secret Manager
# on Cloud Run. See README.md for the target values of the limits.

# Required.
GCP_PROJECT=
GCP_REGION=
GEMINI_MODEL=
EVENT_ID=

# Required. The service refuses to start if any of these is unset (S3.5).
CHECK_RATE_LIMIT_PER_MIN=
CHECK_DAILY_CALL_CAP=
CHECK_MAX_INPUT_CHARS=
CHECK_MAX_IMAGE_BYTES=

# Optional: uncomment only to override the default. A blank value here would override it with "".
# EVENTS_DIR=                 (default: events)
# CORS_ORIGINS=               (default: http://localhost:5173; comma-separated)
# CHECK_ENABLED=              (default: true; false serves only already-cached checks)
# FACT_CHECK_API_KEY=       (optional; Google Fact Check Tools key, a secret: keep it in Secret Manager)
# LOG_LEVEL=                  (default: INFO)
# CHECK_REQUEST_TIMEOUT_S=    (default: 80; whole-request deadline)
# TRUSTED_PROXY_HOPS=         (default: 1; use 2 behind a load balancer)
